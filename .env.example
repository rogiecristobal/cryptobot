# Which exchange to trade on: bitunix or bybit. Only that one's keys are needed.
# Each exchange has its own trade database, so switching back picks up its open trades.
EXCHANGE=bitunix

# Bitunix futures API (no testnet exists — mainnet only)
BITUNIX_API_KEY=
BITUNIX_API_SECRET=

# Bybit V5 API (mainnet, Unified Trading Account). Key permissions:
# Contract - Orders + Positions (read-write). Never withdrawal.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk / sizing
RISK_PERCENT=2.0
# Hard ceiling per trade: a /place RISK value or Bitunix's minimum order size can't go above it
MAX_RISK_PERCENT=5.0
DCA_SPLIT_RATIO=0.5
# Leverage when /place has no "5x", by entry price: min_price:leverage, highest match wins.
# 10000+ 100x | 1000+ 50x | 100+ 25x | 10+ 20x | 1+ 20x | below 1 10x. Bitunix's max still applies.
LEVERAGE_TIERS=10000:100,1000:50,100:25,10:20,1:20,0:10
DEFAULT_MARGIN_MODE=CROSS

# Confirmation
CONFIRM_TIMEOUT_SECONDS=120
BREAKEVEN_TIMEOUT_SECONDS=60
# Breakeven SL goes this % past entry (profit side) to cover fees. 0 = exactly at entry
BREAKEVEN_OFFSET_PERCENT=0.15

# How often the watchdog re-checks every trade's SL against Bitunix
WATCHDOG_INTERVAL_SECONDS=30

# How often the bot-side trailing stop checks mark prices (Bitunix has no native trailing stop)
TRAILING_INTERVAL_SECONDS=5

# ---------- Sweep & Engulf strategy worker (se/) ----------
# Runs inside this bot (same `python3 main.py`), trades BTC/ETH/SOL on 4h from its own budget.
# Defaults match the backtest. Set SE_ENABLED=false to turn it off completely.
SE_ENABLED=true
# paper = simulate only (default). Live needs SE_LIVE_CONFIRM below AND /se_mode live + confirm in Telegram.
SE_MODE=paper
SE_LIVE_CONFIRM=
SE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SE_BUDGET_USDT=100
SE_RISK_PCT=3.0
SE_COMPOUND=true
# same | three_in_a_row | mixed
SE_PREV_CANDLE_MODE=same
SE_EMA_FILTER=true
SE_EMA_LENGTH=200
# atr | candle
SE_SL_MODE=atr
SE_ATR_LENGTH=14
SE_ATR_MULT=1.0
SE_RR=4.0
SE_DIRECTION=long
# Losing trades in a row before no new trades until the next UTC day; 0 = off
SE_DAILY_LOSS_LIMIT=2
SE_MIN_ORDER_USDT=10
SE_LATE_ENTRY_MINUTES=15
# Fee per side (%) used by paper mode and the replay; live uses Bitunix's real fees
SE_FEE_PCT=0.06
# Bug-catcher: refuse any trade that would put more than this x equity into positions
SE_MAX_POSITION_EQUITY_MULT=1.05
